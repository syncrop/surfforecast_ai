NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_NAME=surfspots

# Empty until you have a real key - see AI module docs for what degrades without it.
ANTHROPIC_API_KEY=

# Shared secret required in the `x-admin-key` header for POST /spots and
# POST /forecasts/ingest-now. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
